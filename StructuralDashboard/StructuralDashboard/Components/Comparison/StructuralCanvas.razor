@inject IRendererService Renderer

<div id="structural-canvas" style="width:100%; height:100%; overflow:hidden;"></div>

@code {
    [Parameter] public PlanViewCanvas Model { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Renderer.InitializeAsync("structural-canvas", DotNetObjectReference.Create<object>(this));
        }

        if (Model is null) return;
        await Renderer.RenderAsync(Model);
    }
}