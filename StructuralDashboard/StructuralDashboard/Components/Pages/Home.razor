@page "/"
@* Won't work without rendermode change *@
@* Blazor Auto defaults to loading statically rendered pages from server *@
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IProjectService ProjectService

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <h1>Projects</h1>
    <MudGrid Class="mb-4">
        <MudItem xs="3">
            <MudTextField @bind-Value="_newProject.ProjectNumber"
                          Label="Project Number" />
        </MudItem>
        <MudItem xs="6">
            <MudTextField @bind-Value="_newProject.ProjectName"
                          Label="Project Name" />
        </MudItem> 
        <MudItem xs="3">
            <MudButton  Variant="Variant.Filled"
                        Color="Color.Primary"
                        OnClick="CreateProject">
                Create Project
            </MudButton>
        </MudItem>
    </MudGrid>
    <MudTable Items="_projects" TotalItems="10" Hover="true">
        <HeaderContent>
            <MudTh Style="width: 1%; white-space: nowrap;">Project Number</MudTh>
            <MudTh>Project Name</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="width: 1%; white-space: nowrap;">@context.ProjectNumber</MudTd>
            <MudTd>@context.ProjectName</MudTd>
            <MudTd Style="width: 1%; white-space: nowrap">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               OnClick = "() => EditProject(context)"
                              />
            </MudTd>
            <MudTd Style="width: 1%; white-space: nowrap">  
                <MudIconButton  Icon="@Icons.Material.Filled.Delete"
                                Color="Color.Error"
                                OnClick="() => DeleteProject(context)"/>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<Project> _projects = new();
    private Project _newProject = new();

    protected override async Task OnInitializedAsync()
    {
        _projects = await ProjectService.GetAllAsync();
    }   

    private async Task DeleteProject(Project project)
    {
        await ProjectService.DeleteAsync(project.ProjectNumber);
        _projects = await ProjectService.GetAllAsync();
    }

    private async Task CreateProject()
    {
        // Send Project to API
        await ProjectService.CreateAsync(_newProject);

        // Refresh Projects 
        _projects = await ProjectService.GetAllAsync();

        // Clear form
        _newProject = new Project();
    }

    private Task EditProject(Project project)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        return DialogService.ShowAsync<EditProjectDialog>("Edit Project", options);
    }
}