@page "/plan"
@rendermode InteractiveServer
@inject IWebHostEnvironment Env

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" mud-width-full>
    <MudCheckBox @bind-Value="_isRevitVisible"></MudCheckBox>

    <MudSelect  @bind-Value="_revitSelectedLevel"
                @bind-Value:after="OnLevelChanged"
                Variant="Variant.Outlined"
                Style="width: 300px; flex-shrink: 0; flex-grow: 0;">
           
        @foreach (var level in _revitLevels)
        {
            <MudSelectItem Value="level">@level.Name </MudSelectItem>
        }
    </MudSelect>

    <MudCheckBox @bind-Value="_isAnalysisVisible"></MudCheckBox>

    <MudSelect @bind-Value="_analysisSelectedLevel"
               @bind-Value:after="OnLevelChanged"
               Variant="Variant.Outlined"
               Style="width: 300px; flex-shrink: 0; flex-grow: 0;">
           
        @foreach (var level in _analysisLevels)
        {
            <MudSelectItem Value="level">@level.Name </MudSelectItem>
        }
    </MudSelect>
</MudStack>

<div style="@(_isRevitVisible ? "" : "display:none")">
    <StructuralCanvas Model = "_revitSelectedPlanView"/>
</div>


@code {
    private Level _revitSelectedLevel;
    private Level _analysisSelectedLevel;

    private PlanViewModel _revitSelectedPlanView; 
    private PlanViewModel _analysisSelectedPlanView;

    private List<PlanViewModel> _revitPlanViewModels = new List<PlanViewModel>();
    private List<PlanViewModel> _analysisPlanViewModels = new List<PlanViewModel>();

    private List<Level> _revitLevels = new List<Level>();
    private List<Level> _analysisLevels = new List<Level>();

    private StructuralModel _revitStructuralModel;
    private StructuralModel _analysisStructuralModel;

    private bool _isRevitVisible = true;
    private bool _isAnalysisVisible = true;

    protected override void OnInitialized()
    {
        var revitPath = Path.Combine(Env.ContentRootPath, "Data", "RevitModel.json");
        var analysisPath = Path.Combine(Env.ContentRootPath, "Data", "AnalysisModel.json");

        _revitStructuralModel = ModelLoaderService.LoadFromFile(revitPath);
        _analysisStructuralModel = ModelLoaderService.LoadFromFile(analysisPath);

        _revitLevels = _revitStructuralModel.ModelLayout.Levels;
        _analysisLevels = _analysisStructuralModel.ModelLayout.Levels;

        _revitSelectedLevel = _revitLevels.First();
        _analysisSelectedLevel = _analysisLevels.First();

        _revitPlanViewModels = _revitStructuralModel.ConvertToPlanViewModels();
        _analysisPlanViewModels = _analysisStructuralModel.ConvertToPlanViewModels();

        _revitSelectedPlanView = _revitPlanViewModels.First();
        _analysisSelectedPlanView = _analysisPlanViewModels.First();
    }

    private void OnLevelChanged()
    {
        _revitSelectedPlanView = _revitPlanViewModels.FirstOrDefault(m => m.LevelId == _revitSelectedLevel.Id); 
        _analysisSelectedPlanView = _analysisPlanViewModels.FirstOrDefault(m => m.LevelId == _analysisSelectedLevel.Id);
    }
}
